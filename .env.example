# Copy this file to ".env.local" for local work. On Vercel, set these in
# Project -> Settings -> Environment Variables instead.

# Postgres connection string.
# On Vercel, connecting a Neon database (Storage tab) adds DATABASE_URL for you.
DATABASE_URL=postgresql://neondb_owner:npg_i57fuYObXnlH@ep-square-sound-b8itwm93-pooler.c-14.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# If you set a code, people must type it to create an account.
# Strongly recommended once the site is public. Leave empty to allow open sign-up.
INVITE_CODE=

# false = a purchase bigger than the remaining balance is rejected.
ALLOW_OVERSPEND=false

# How many days a login stays valid.
SESSION_DAYS=14

# Currency label shown next to every amount (this one is visible in the browser).
NEXT_PUBLIC_CURRENCY=RWF
